From 0976fec83eca5ec42b588623ef0919e8a1d53ad6 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Sat, 28 Nov 2026 14:01:08 -0500
Subject: [PATCH 2/2] opencv_ext: Do not rotate TIFF twice

OpenCV's TIFF decoder applies the Orientation tag even with
IMREAD_IGNORE_ORIENTATION, so applying the parsed orientation on top
rotated tagged TIFFs twice. Skip our rotation for TIFF, and decline
(ORIENTATION_UNSUPPORTED) when stored order is requested for a tagged
TIFF, since OpenCV cannot provide it.
---
 extensions/opencv/opencv_decoder.cpp          |  85 +++++---
 test/CMakeLists.txt                           |   1 +
 .../opencv_ext_tiff_orientation_test.cpp      | 192 ++++++++++++++++++
 3 files changed, 245 insertions(+), 33 deletions(-)
 create mode 100644 test/extensions/opencv_ext_tiff_orientation_test.cpp

diff --git a/extensions/opencv/opencv_decoder.cpp b/extensions/opencv/opencv_decoder.cpp
index 6bcb2a7..cd676a8 100644
--- a/extensions/opencv/opencv_decoder.cpp
+++ b/extensions/opencv/opencv_decoder.cpp
@@ -33,6 +33,50 @@
 
 namespace opencv {
 
+namespace {
+
+bool isIdentityOrientation(const nvimgcodecOrientation_t& orientation)
+{
+    return orientation.rotated == 0 && !orientation.flip_x && !orientation.flip_y;
+}
+
+// OpenCV's TIFF decoder applies the TIFF Orientation tag itself and ignores
+// IMREAD_IGNORE_ORIENTATION.
+bool opencvAlwaysOrients(const char* codec_name)
+{
+    return strcmp(codec_name, "tiff") == 0;
+}
+
+// nvimgcodecOrientation_t: counter-clockwise rotation, then flips in display space.
+void applyOrientation(cv::Mat& img, const nvimgcodecOrientation_t& orientation)
+{
+    cv::Mat rotated;
+    switch (orientation.rotated) {
+    case 90:
+        cv::rotate(img, rotated, cv::ROTATE_90_COUNTERCLOCKWISE);
+        img = rotated;
+        break;
+    case 180:
+        cv::rotate(img, rotated, cv::ROTATE_180);
+        img = rotated;
+        break;
+    case 270:
+        cv::rotate(img, rotated, cv::ROTATE_90_CLOCKWISE);
+        img = rotated;
+        break;
+    default:
+        break;
+    }
+    if (orientation.flip_x && orientation.flip_y)
+        cv::flip(img, img, -1);
+    else if (orientation.flip_x)
+        cv::flip(img, img, 1);
+    else if (orientation.flip_y)
+        cv::flip(img, img, 0);
+}
+
+} // namespace
+
 struct DecoderImpl
 {
     DecoderImpl(const char* plugin_id, const nvimgcodecFrameworkDesc_t* framework, const nvimgcodecExecutionParams_t* exec_params);
@@ -205,6 +249,11 @@ nvimgcodecProcessingStatus_t DecoderImpl::canDecode(
             break;
         }
 
+        if (!params->apply_exif_orientation && opencvAlwaysOrients(cs_image_info.codec_name) &&
+            !isIdentityOrientation(image_info.orientation)) {
+            status |= NVIMGCODEC_PROCESSING_STATUS_ORIENTATION_UNSUPPORTED;
+        }
+
         if (tile_geometry.tile_offset_x > 0 || tile_geometry.tile_offset_y > 0) {
             NVIMGCODEC_LOG_ERROR(framework_, plugin_id_, "Non-zero tile offsets are not supported");
             status |= NVIMGCODEC_PROCESSING_STATUS_TILING_UNSUPPORTED;
@@ -294,38 +343,6 @@ nvimgcodecStatus_t DecoderImpl::static_destroy(nvimgcodecDecoder_t decoder)
     return NVIMGCODEC_STATUS_SUCCESS;
 }
 
