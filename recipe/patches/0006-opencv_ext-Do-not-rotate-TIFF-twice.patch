diff --git a/test/extensions/opencv_ext_tiff_orientation_test.cpp b/test/extensions/opencv_ext_tiff_orientation_test.cpp
new file mode 100644
index 0000000..1db577c
--- /dev/null
+++ b/test/extensions/opencv_ext_tiff_orientation_test.cpp
@@ -0,0 +1,192 @@
